```{r}
#| label: import

# Cleaned data from IC10-2-1 (keeps value labels and variable labels)
data <- read_sav("Case 31 Data_efcu_1_RG_cleaned.sav")

# Plain-number copy used for means, t-tests, and percentages
data_numeric <- data |>
  mutate(across(everything(), as.numeric))

n_respondents <- nrow(data)
