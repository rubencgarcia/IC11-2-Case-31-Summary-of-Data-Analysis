```{r}
#| label: helper-distribution

# Frequency table for one variable, using its value labels
distribution_table <- function(variable_name) {
  variable_labelled <- data[[variable_name]]

  codes <- as.numeric(variable_labelled)
  labels_text <- as.character(as_factor(variable_labelled))

  raw_table <- tibble(code = codes, response = labels_text)
  raw_table <- raw_table |>
    mutate(response = replace_na(response, "No opinion / no answer (missing)"))

  counts <- raw_table |> count(code, response)

  n_valid <- sum(counts |> filter(!is.na(code)) |> pull(n))

  result <- counts |>
    mutate(
      variable = variable_name,
      percent_of_all = round(n / sum(n) * 100, 1),
      percent_of_valid = if_else(is.na(code), NA_real_, round(n / n_valid * 100, 1))
    ) |>
    arrange(code) |>
    select(variable, code, response, n, percent_of_all, percent_of_valid)

  result
}

# Bar chart of valid-response percentages for one variable
distribution_plot <- function(variable_name) {
  plot_data <- distribution_table(variable_name) |>
    filter(!is.na(code)) |>
    mutate(response = fct_reorder(response, code))

  ggplot(plot_data, aes(x = response, y = percent_of_valid)) +
    geom_col(fill = "#1f4e79") +
    geom_text(aes(label = paste0(round(percent_of_valid, 0), "%")), vjust = -0.4, size = 5) +
    scale_y_continuous(expand = expansion(mult = c(0, 0.15))) +
    labs(x = NULL, y = "Percent of valid responses")
}

# Pull one number out of a distribution table
get_percent <- function(freq_table, code_value) {
  freq_table |> filter(code == code_value) |> pull(percent_of_valid)
}
```

```{r}
#| label: helper-ttest

# One-sample t-test against a test value (default = 3, the scale midpoint)
one_sample_row <- function(variable_name, description, test_value = 3) {
  all_values <- data_numeric[[variable_name]]
  valid_values <- all_values[!is.na(all_values)]

  test_result <- t.test(valid_values, mu = test_value)
  test_tidy <- broom::tidy(test_result)

  row <- tibble(
    item = variable_name,
    description = description,
    n = length(valid_values),
    mean = mean(valid_values),
    sd = sd(valid_values),
    percent_4_or_5 = mean(valid_values >= 4) * 100,
    t = test_tidy |> pull(statistic),
    df = test_tidy |> pull(parameter),
    p = test_tidy |> pull(p.value),
    conf_low = test_tidy |> pull(conf.low),
    conf_high = test_tidy |> pull(conf.high)
  )

  row
}

# Add text versions of the test result for use inside parentheses
add_report_text <- function(results) {
  results |>
    mutate(
      p_text = if_else(p < .001, "p < .001", paste0("p = ", sub("^0", "", sprintf("%.3f", p)))),
      report = paste0("t(", df, ") = ", sprintf("%.2f", t), ", ", p_text),
      direction = if_else(mean > 3, "above", "below"),
      sig_word = if_else(p < .05, "significantly", "not significantly")
    )
}

# Nicely formatted results table
show_results_table <- function(results) {
  results |>
    select(description, n, mean, sd, percent_4_or_5, t, p_text) |>
    gt() |>
    fmt_number(columns = c(mean, sd, percent_4_or_5, t), decimals = 2) |>
    cols_label(
      description = "Item",
      n = "n",
      mean = "Mean",
      sd = "SD",
      percent_4_or_5 = "% rating 4-5",
      t = "t",
      p_text = "Significance"
    )
}

get_value <- function(results, item_name, column_name) {
  results |> filter(item == item_name) |> pull(all_of(column_name))
}
```

# Case Overview

## Objectives and data

EFCU wants to know why members are not borrowing more from the credit union. This summary covers four research questions:

- **R1:** Why do people join the credit union?
- **R2:** Why do members use other financial institutions when they borrow?
- **R5:** How well are members aware of the services offered?
- **R6:** What are members' attitudes about how effectively the credit union is operated?

The analysis uses the cleaned survey data (n = `r n_respondents`). Missing values come from "No opinion" and "No answer" responses. Scale midpoint = 3 on 1-5 items (higher = more favorable or higher, as labeled).

::: {.callout-note}
The cleaned file does not contain Q1, Q2, Q28, Q29, or the open-ended questions. R1 and R2 therefore use the closest available survey items (see the Limitations slide).
:::

# R1: Reasons for Joining

## R1 Descriptive statistics: opinion of savings rates (Q7)

```{r}
#| label: tbl-r1-freq
#| tbl-cap: "Opinion of the rates the credit union pays on savings accounts (Q7, reversed so higher = higher rates)"

r1_table <- distribution_table("q7r")

r1_table |>
  select(response, n, percent_of_all, percent_of_valid) |>
  gt() |>
  cols_label(
    response = "Response",
    n = "n",
    percent_of_all = "% of all",
    percent_of_valid = "% of valid"
  )
```

## R1 Figure

```{r}
#| label: fig-r1
#| fig-cap: "Opinion of savings rates paid by the credit union (valid responses)"
#| fig-height: 4.5

distribution_plot("q7r")
```

## R1 One-group t-test (test value = 3, "Average")

```{r}
#| label: tbl-r1-ttest
#| tbl-cap: "One-sample t-test: Q7 savings rates vs. the midpoint of 3"

r1_results <- one_sample_row("q7r", "Savings rates paid (Q7r)")
r1_results <- add_report_text(r1_results)

show_results_table(r1_results)
```

```{r}
#| label: r1-numbers

r1_pct_average <- get_percent(r1_table, 3)
r1_pct_high <- get_percent(r1_table, 4) + get_percent(r1_table, 5)
r1_pct_low <- get_percent(r1_table, 1) + get_percent(r1_table, 2)
```

## R1 Insight

Q2 (reasons for joining) is not in the data, so the best stand-in is Q7, because "higher interest rates on savings" is one of the reasons to join.

Most members, `r r1_pct_average`%, rate EFCU's savings rates as average (@tbl-r1-freq, @fig-r1). Among the rest, `r r1_pct_high`% call the rates high or very high and `r r1_pct_low`% call them low or very low. The average rating (`r round(get_value(r1_results, "q7r", "mean"), 2)`) is `r get_value(r1_results, "q7r", "sig_word")` different from the midpoint (`r get_value(r1_results, "q7r", "report")`; @tbl-r1-ttest).

**Story:** savings rates are seen as ordinary, not a standout reason that members would say draws them in.

