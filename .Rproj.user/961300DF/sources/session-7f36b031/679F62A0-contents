## R6 Figure

```{r}
#| label: fig-r6
#| fig-cap: "Mean rating with 95% confidence interval (dashed line = midpoint of 3)"
#| fig-height: 4.5
#| fig-width: 10

r6_plot_data <- r6_results |>
  mutate(description = fct_reorder(description, mean))

ggplot(r6_plot_data, aes(x = mean, y = description)) +
  geom_vline(xintercept = 3, linetype = "dashed") +
  geom_pointrange(aes(xmin = conf_low, xmax = conf_high), color = "#1f4e79") +
  scale_x_continuous(limits = c(2.5, 5)) +
