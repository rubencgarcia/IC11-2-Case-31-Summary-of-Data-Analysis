```{r}
#| label: r2-numbers

r2_pct_average <- get_percent(r2_table_q8, 3)
r2_pct_high <- get_percent(r2_table_q8, 4) + get_percent(r2_table_q8, 5)
r2_pct_low <- get_percent(r2_table_q8, 1) + get_percent(r2_table_q8, 2)

r2_table_q30 <- distribution_table("q30")
r2_pct_agree <- get_percent(r2_table_q30, 4) + get_percent(r2_table_q30, 5)
r2_pct_disagree <- get_percent(r2_table_q30, 1) + get_percent(r2_table_q30, 2)
r2_pct_uncertain <- get_percent(r2_table_q30, 3)

r2_table_q27 <- distribution_table("q27")
r2_pct_have_loan <- get_percent(r2_table_q27, 1)
```

## R2 Insight

Q28 and Q29 (borrowing elsewhere and why) are not in the data, so I looked at how members see EFCU's loan rates, since "I found better loan rates elsewhere" is one of the Q29 reasons.

About `r r2_pct_average`% of members call EFCU's loan rates average, `r r2_pct_high`% call them high, and `r r2_pct_low`% call them low (@tbl-r2-freq). The mean (`r round(get_value(r2_results, "q8r", "mean"), 2)`) is `r get_value(r2_results, "q8r", "sig_word")` different from average (`r get_value(r2_results, "q8r", "report")`). On Q30, only `r r2_pct_agree`% agree that EFCU rates are lower than other institutions, while `r r2_pct_disagree`% disagree and `r r2_pct_uncertain`% are uncertain (@fig-r2); the mean is `r get_value(r2_results, "q30", "sig_word")` different from 3 (`r get_value(r2_results, "q30", "report")`; @tbl-r2-ttest).

**Story:** EFCU is not seen as a clear loan-rate leader. Members do not strongly believe its rates beat competitors, so rates alone give members little reason to stay. Only `r r2_pct_have_loan`% currently have a loan with EFCU (Q27). The survey cannot confirm *why* members borrow elsewhere.

# R5: Awareness of Services

## R5 Descriptive statistics: awareness and use of 14 services

```{r}
#| label: r5-prep

service_labels <- var_label(select(data, q13:q26), unlist = TRUE)

service_names <- tibble(
  item = names(service_labels),
  service = str_to_sentence(unname(service_labels))
)

awareness_numeric <- data_numeric |>
  select(q13:q26) |>
  mutate(respondent = row_number())

awareness_long <- awareness_numeric |>
  pivot_longer(-respondent, names_to = "item", values_to = "response")

awareness_counts <- awareness_long |>
  count(item, response)

awareness_percent <- awareness_counts |>
  mutate(percent = n / sum(n) * 100, .by = item)

awareness_percent <- awareness_percent |>
  mutate(
    response_label = case_match(
      response,
      1 ~ "Aware and used",
      2 ~ "Aware, not used",
      3 ~ "Unaware"
    )
  )

awareness_percent <- awareness_percent |>
  left_join(service_names, by = "item")

awareness_wide <- awareness_percent |>
  select(item, service, response_label, percent) |>
  pivot_wider(names_from = response_label, values_from = percent, values_fill = 0)

awareness_wide <- awareness_wide |>
  mutate(percent_aware = `Aware and used` + `Aware, not used`)

# Mean of the reversed ordinal version (1 = unaware, 3 = aware and used)
engagement_means <- data_numeric |>
  select(q13r:q26r) |>
  summarise(across(everything(), \(x) mean(x, na.rm = TRUE))) |>
  pivot_longer(everything(), names_to = "item_r", values_to = "mean_engagement") |>
  mutate(item = str_remove(item_r, "r$")) |>
  select(item, mean_engagement)

awareness_wide <- awareness_wide |>
  left_join(engagement_means, by = "item")

awareness_wide <- awareness_wide |>
  arrange(desc(percent_aware))
```

```{r}
#| label: tbl-r5
#| tbl-cap: "Awareness and use of EFCU services (percent of respondents), sorted by awareness"

awareness_wide |>
  select(service, `Aware and used`, `Aware, not used`, Unaware, percent_aware, mean_engagement) |>
  gt() |>
  fmt_number(columns = c(`Aware and used`, `Aware, not used`, Unaware, percent_aware), decimals = 1) |>
  fmt_number(columns = mean_engagement, decimals = 2) |>
  cols_label(
    service = "Service",
    percent_aware = "Total aware (%)",
    mean_engagement = "Engagement (1-3)"
  )
```

## R5 Figure

```{r}
#| label: fig-r5
#| fig-cap: "Awareness and use of EFCU services, ordered by share aware"
#| fig-height: 6.5
#| fig-width: 10

service_order <- awareness_wide |>
  arrange(percent_aware) |>
  pull(service)

awareness_plot_data <- awareness_percent |>
  mutate(
    service = factor(service, levels = service_order),
    response_label = factor(response_label, levels = c("Unaware", "Aware, not used", "Aware and used"))
  )

ggplot(awareness_plot_data, aes(x = percent, y = service, fill = response_label)) +
  geom_col() +
  scale_fill_manual(values = c("Unaware" = "#c0504d", "Aware, not used" = "#a6a6a6", "Aware and used" = "#1f4e79")) +
  labs(x = "Percent of respondents", y = NULL, fill = NULL) +
  theme(legend.position = "top")
```

```{r}
#| label: r5-numbers

most_aware_row <- awareness_wide |> slice_max(percent_aware, n = 1, with_ties = FALSE)
least_aware_row <- awareness_wide |> slice_min(percent_aware, n = 1, with_ties = FALSE)

most_used_row <- awareness_wide |> slice_max(`Aware and used`, n = 1, with_ties = FALSE)
least_used_row <- awareness_wide |> slice_min(`Aware and used`, n = 1, with_ties = FALSE)

n_services_quarter_unaware <- awareness_wide |>
  filter(Unaware >= 25) |>
  nrow()

n_services_majority_used <- awareness_wide |>
  filter(`Aware and used` >= 50) |>
  nrow()
most_aware_service <- pull(most_aware_row, service)
most_aware_percent <- round(pull(most_aware_row, percent_aware), 1)
least_aware_service <- pull(least_aware_row, service)
least_aware_percent <- round(pull(least_aware_row, percent_aware), 1)

most_used_service <- pull(most_used_row, service)
most_used_percent <- round(pull(most_used_row, `Aware and used`), 1)
least_used_service <- pull(least_used_row, service)
least_used_percent <- round(pull(least_used_row, `Aware and used`), 1)
```

## R5 Insight

Awareness is uneven across the 14 services (@tbl-r5, @fig-r5).

-- Highest awareness: **`r most_aware_service`** (`r most_aware_percent`% aware). Lowest awareness: **`r least_aware_service`** (`r least_aware_percent`% aware).
- Most used: **`r most_used_service`** (`r most_used_percent`% have used it). Least used: **`r least_used_service`** (`r least_used_percent`%).
- `r n_services_quarter_unaware` of 14 services have at least 25% of members who did not know the service was offered, and only `r n_services_majority_used` of 14 are used by at least half of members.

**Story:** awareness is not the same as use. Services where many members are aware but have not used them are a conversion opportunity, and services with high "unaware" shares are a communication gap.

# R6: Operational Effectiveness

## R6 Descriptive statistics: account statements (Q9 to Q12)

```{r}
#| label: tbl-r6-freq
#| tbl-cap: "Statement frequency, accuracy, clarity, and confidentiality (percent of valid responses)"

r6_q9 <- distribution_table("q9")
r6_q10 <- distribution_table("q10")
r6_q11 <- distribution_table("q11")
r6_q12 <- distribution_table("q12")

r6_frequencies <- bind_rows(r6_q9, r6_q10, r6_q11, r6_q12)

r6_variable_names <- c(
  q9 = "Q9: How often statements are received",
  q10 = "Q10: Accuracy of statements",
  q11 = "Q11: Statements easy to understand",
  q12 = "Q12: Account information kept confidential"
)

r6_frequencies |>
  filter(!is.na(code)) |>
  mutate(variable = r6_variable_names[variable]) |>
  select(variable, response, n, percent_of_valid) |>
  gt(groupname_col = "variable") |>
  cols_label(response = "Response", n = "n", percent_of_valid = "% of valid")
```

## R6 Chi-square goodness-of-fit tests (Q9, Q11, Q12)

```{r}
#| label: tbl-r6-gof
#| tbl-cap: "Chi-square goodness-of-fit tests (equal split across response options)"

q9_counts <- r6_q9 |> filter(!is.na(code)) |> pull(n)
q11_counts <- r6_q11 |> filter(!is.na(code)) |> pull(n)
q12_counts <- r6_q12 |> filter(!is.na(code)) |> pull(n)

q9_gof <- broom::tidy(chisq.test(q9_counts))
q11_gof <- broom::tidy(chisq.test(q11_counts))
q12_gof <- broom::tidy(chisq.test(q12_counts))

gof_table <- bind_rows(
  q9_gof |> mutate(item = "Q9: Statement frequency"),
  q11_gof |> mutate(item = "Q11: Easy to understand"),
  q12_gof |> mutate(item = "Q12: Confidential")
)

gof_table <- gof_table |>
  mutate(
    p_text = if_else(p.value < .001, "p < .001", paste0("p = ", sub("^0", "", sprintf("%.3f", p.value))))
  )

gof_table |>
  select(item, statistic, parameter, p_text) |>
  gt() |>
  fmt_number(columns = statistic, decimals = 2) |>
  cols_label(item = "Item", statistic = "Chi-square", parameter = "df", p_text = "Significance")
```

